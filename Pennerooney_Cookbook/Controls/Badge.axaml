<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Pennerooney_Cookbook.Models"
        x:DataType="m:Recipe"
        >
   
    <Design.PreviewWith>
        <Badge />
    </Design.PreviewWith>
    
    <Style Selector="Badge">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource SecondaryBackgroundGradient}"
                        Padding="10,0,10,0"
                        CornerRadius="16"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        >
                    <Label Content="{Binding Method.Title}" 
                           Foreground="{DynamicResource text-dark}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0"
                           />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    
</Styles>
